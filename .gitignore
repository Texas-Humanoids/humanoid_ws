# colcon build outputs (regenerate with `colcon build`)
build*/
install*/
log*/


# pixi environment (recreate with `pixi install`)
.pixi/

# Python
__pycache__/
*.pyc
.venv/

# Training outputs (deployed policies go in policies/ instead)
training/logs/
training/outputs/
training/wandb/
training/**/*.pt

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
.DS_Store

# Firmware build outputs
firmware/**/build/
*.elf
*.bin
*.hex
*.map
