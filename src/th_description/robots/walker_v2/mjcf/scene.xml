<!-- WalkerV2 on a flat floor, for th_sim (MuJoCo sim2sim of the ROS deploy stack). -->
<mujoco model="walker_v2_scene">
  <include file="walker_v2.xml"/>

  <!-- 1 kHz physics; th_sim runs the motor PD at this rate like the motor's own loop. -->
  <option timestep="0.001" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="140" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" texuniform="true" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <!-- contype 1 / conaffinity 2: touches the robot's collision boxes (contype 2, conaffinity 1). -->
    <geom name="floor" size="0 0 0.05" type="plane" material="grid" contype="1" conaffinity="2"
      friction="1.0 0.005 0.0001"/>
    <!-- Gantry: a mocap anchor welded to base_link while th_sim holds the robot up. -->
    <body name="gantry" mocap="true" pos="0 0 0.67"/>
  </worldbody>

  <equality>
    <weld name="gantry" body1="gantry" body2="base_link" solref="0.02 1"/>
  </equality>
</mujoco>
