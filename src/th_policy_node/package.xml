<?xml version="1.0"?>
<package format="3">
  <name>th_policy_node</name>
  <version>0.1.0</version>
  <description>Runs a trained ONNX walking policy on policy-ready observations.</description>
  <maintainer email="noreply@github.com">Texas Humanoids Controls</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
