<?xml version="1.0"?>
<package format="3">
  <name>th_autonomy</name>
  <version>0.1.0</version>
  <description>Camera-driven following (AprilTag or person) that command the walking policy over /cmd_vel.</description>
  <maintainer email="noreply@github.com">Texas Humanoids Controls</maintainer>
  <license>MIT</license>

  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>foxglove_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>th_foxglove</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- person_follower runs its pose model with TensorRT and cuda-python (Dockerfile.gpu), or on
       the CPU with the onnxruntime pip package (both Dockerfiles), much slower. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
