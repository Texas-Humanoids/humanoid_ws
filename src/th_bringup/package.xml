<?xml version="1.0"?>
<package format="3">
  <name>th_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and config that start the Texas Humanoids robot.</description>
  <maintainer email="noreply@github.com">Texas Humanoids Controls</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>gamepad_node</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robstride_motor</exec_depend>
  <exec_depend>th_policy_bridge</exec_depend>
  <exec_depend>th_policy_node</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
