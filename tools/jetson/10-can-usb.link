# Give the USB-CAN adapter (gs_usb / CANable) a fixed name. Without this it
# comes up as can0 or can1 depending on whether gs_usb or the Jetson's built-in
# mttcan driver registers first at boot.
[Match]
Driver=gs_usb

[Link]
Name=can_usb
# 1000, not the CAN default 10: five motor nodes share one adapter at 100 Hz each, and a
# 10-frame queue overflows whenever USB pauses ("CAN write failed", 300+ ms feedback gaps).
TransmitQueueLength=1000
