# Settings for bench-camera.service; installed to /etc/default/bench-camera.
# Edit there and run `sudo systemctl restart bench-camera` to apply.

# video-index0 is the MJPEG/YUYV node (index2 is H.264 only; 1 and 3 are metadata).
CAMERA_DEVICE=/dev/v4l/by-id/usb-Arducam_Technology_Co.__Ltd._Arducam_1080P_Low_Light_UC684-video-index0
# 1280x720 keeps Wi-Fi bandwidth reasonable; 1920x1080 also works at up to 30 fps.
CAMERA_RESOLUTION=1280x720
CAMERA_FPS=30
CAMERA_PORT=8080
