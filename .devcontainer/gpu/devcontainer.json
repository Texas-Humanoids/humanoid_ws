{
  "name": "Isaac ROS (GPU)",
  "dockerComposeFile": "../../compose.yaml",
  "service": "gpu",
  "runServices": [
    "gpu"
  ],
  "workspaceFolder": "/ws",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools"
      ],
      "settings": {
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/**",
          "/opt/ros/jazzy/include/**",
          "/usr/include/opencv4"
        ],
        "C_Cpp.default.cppStandard": "c++17"
      }
    }
  }
}
